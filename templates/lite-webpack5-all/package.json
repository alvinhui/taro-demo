{
  "name": "lite-webpack5-all",
  "version": "1.0.0",
  "private": true,
  "description": "包含多端的 Lite 示例",
  "packageManager": "pnpm@10.33.4",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "Sass",
    "framework": "React"
  },
  "scripts": {
    "prepare": "husky",
    "new": "taro new",
    "build:weapp": "taro build --type weapp",
    "build:swan": "taro build --type swan",
    "build:alipay": "taro build --type alipay",
    "build:tt": "taro build --type tt",
    "build:h5": "taro build --type h5",
    "build:harmony": "node ../../harmony/scripts/build-demo.mjs lite-webpack5-all",
    "build:hap": "node ../../harmony/scripts/build-hap.mjs",
    "build:rn": "taro build --type rn",
    "build:qq": "taro build --type qq",
    "build:jd": "taro build --type jd",
    "dev:weapp": "npm run build:weapp -- --watch",
    "dev:swan": "npm run build:swan -- --watch",
    "dev:alipay": "npm run build:alipay -- --watch",
    "dev:tt": "npm run build:tt -- --watch",
    "dev:h5": "npm run build:h5 -- --watch",
    "dev:harmony": "node ../../harmony/scripts/watch-demo.mjs lite-webpack5-all",
    "dev:rn": "npm run build:rn -- --watch --qr",
    "dev:qq": "npm run build:qq -- --watch",
    "dev:jd": "npm run build:jd -- --watch"
  },
  "browserslist": [
    "defaults and fully supports es6-module",
    "maintained node versions"
  ],
  "author": "",
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/plugin-platform-alipay": "4.2.1",
    "@tarojs/plugin-platform-tt": "4.2.1",
    "@tarojs/plugin-platform-swan": "4.2.1",
    "@tarojs/plugin-platform-jd": "4.2.1",
    "@tarojs/plugin-platform-qq": "4.2.1",
    "@tarojs/plugin-platform-h5": "4.2.1",
    "@tarojs/plugin-platform-harmony-cpp": "4.2.1",
    "@tarojs/plugin-platform-harmony-ets": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/components-rn": "4.2.1",
    "@tarojs/runtime-rn": "4.2.1",
    "@tarojs/taro-rn": "4.2.1",
    "@tarojs/rn-supporter": "4.2.1",
    "react-native": "^0.73.1",
    "react-native-gesture-handler": "~2.14.0",
    "react-native-safe-area-context": "4.8.2",
    "react-native-screens": "~3.29.0",
    "react-dom": "^18.0.0",
    "react": "^18.0.0"
  },
  "devDependencies": {
    "@tarojs/plugin-generator": "4.2.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "husky": "^9.1.7",
    "stylelint-config-standard": "^38.0.0",
    "@babel/core": "^7.24.4",
    "@tarojs/cli": "4.2.1",
    "@types/react": "^18.0.0",
    "webpack": "5.91.0",
    "@tarojs/webpack5-runner": "4.2.1",
    "@tarojs/vite-runner": "4.2.1",
    "sass": "^1.75.0",
    "babel-preset-taro": "4.2.1",
    "eslint-config-taro": "4.2.1",
    "eslint": "^8.57.0",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.5",
    "react-refresh": "^0.14.0",
    "@babel/preset-react": "^7.24.1",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.4.0",
    "stylelint": ">=16.4.0 <=16.10.0",
    "typescript": "^5.4.5",
    "vite": "^4.2.0",
    "tsconfig-paths-webpack-plugin": "^4.1.0",
    "postcss": "^8.5.6",
    "@types/node": "^18",
    "@tarojs/rn-runner": "4.2.1",
    "@react-native/metro-config": "^0.73.2"
  }
}
